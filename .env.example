# ─────────────────────────────────────────────────────────────
# Evento Brasil — variáveis de ambiente
# Copie para .env. NUNCA versione valores reais.
# Em produção, valores que começam com "dev-only" são rejeitados.
# ─────────────────────────────────────────────────────────────

# Banco de dados (PostgreSQL 15+)
DATABASE_URL="postgresql://evento:evento_dev_password@localhost:5433/evento_brasil"

# URL pública da aplicação (usada em links de e-mail, webhooks e checagem de origem)
APP_URL="http://localhost:3000"

# Segredo para HMAC dos tokens de sessão/convite. Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="dev-only-replace-with-random-secret"

# Chave AES-256 (32 bytes em base64) para cifrar CPF/CNPJ de organizadores. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY="dev-only-ZGV2LW9ubHktMzItYnl0ZXMta2V5LXBsYWNlaG9sZGVy"

# Segredo exigido no header "x-cron-secret" de /api/cron/*
CRON_SECRET="dev-only-cron-secret"

# ── Pagamentos ───────────────────────────────────────────────
# "simulated" (desenvolvimento) | "mercadopago" (desabilitado até verificação — ver docs/payments-mercadopago.md)
PAYMENT_PROVIDER="simulated"
# Segredo HMAC dos webhooks do provedor simulado
SIMULATED_WEBHOOK_SECRET="dev-only-simulated-webhook-secret"
# Permite o provedor simulado com NODE_ENV=production (ex.: ambiente de homologação). Nunca em produção real.
ALLOW_SIMULATED_PAYMENTS_IN_PRODUCTION="false"

# Mercado Pago (credenciais da aplicação de marketplace — preencher apenas após verificação)
MERCADO_PAGO_ACCESS_TOKEN=""
MERCADO_PAGO_CLIENT_ID=""
MERCADO_PAGO_CLIENT_SECRET=""
MERCADO_PAGO_WEBHOOK_SECRET=""
# Liquidação ao organizador fica desligada até configuração e verificação
SETTLEMENT_ENABLED="false"

# ── Pedidos e reembolsos ─────────────────────────────────────
RESERVATION_MINUTES="15"
# A política de reembolso (dias após a compra e horas antes do evento) é definida
# em cada evento pelo organizador; padrões 7 dias e 48 horas.

# ── E-mail transacional ──────────────────────────────────────
# "console" (grava em .data/outbox) | "resend"
EMAIL_PROVIDER="console"
EMAIL_API_KEY=""
EMAIL_FROM="Evento Brasil <nao-responda@example.com>"

# ── Armazenamento de imagens ─────────────────────────────────
# "local" (grava em .data/uploads) | "s3" (qualquer serviço compatível com S3)
STORAGE_PROVIDER="local"
OBJECT_STORAGE_ENDPOINT=""
OBJECT_STORAGE_REGION="auto"
OBJECT_STORAGE_BUCKET=""
OBJECT_STORAGE_ACCESS_KEY=""
OBJECT_STORAGE_SECRET_KEY=""
# URL pública base dos objetos (CDN ou bucket público)
OBJECT_STORAGE_PUBLIC_URL=""
