{
  "name": "evento-brasil",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:oauth": "node --use-system-ca node_modules/next/dist/bin/next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:start": "node scripts/dev-db.mjs",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:status": "node scripts/db-status.mjs",
    "db:reset": "node scripts/db-reset.mjs",
    "db:generate": "prisma generate",
    "cities:import": "tsx --conditions=react-server scripts/import-ibge-cities.ts",
    "ibge:update": "tsx scripts/ibge-update.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:e2e:isolated": "node scripts/test-e2e.mjs",
    "postinstall": "prisma generate",
    "email:worker": "tsx --conditions=react-server scripts/email-worker.ts",
    "email:status": "tsx --conditions=react-server scripts/email-status.ts",
    "email:retry": "tsx --conditions=react-server scripts/email-retry.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@hookform/resolvers": "^5.9.2",
    "@mercadopago/sdk-react": "^1.0.7",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.9",
    "jose": "^6.2.12",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "passkit-generator": "^3.7.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.91.0",
    "resend": "^6.35.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "embedded-postgres": "^17.10.0-beta.17",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "prisma": "^7.10.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "@embedded-postgres/windows-x64@17.10.0-beta.17": true,
    "@prisma/engines@7.10.1": true,
    "esbuild@0.28.2": true,
    "prisma@7.10.1": true,
    "unrs-resolver@1.12.2": true
  },
  "overrides": {
    "joi": "17.13.9"
  }
}
