// Evento Brasil — esquema relacional.
// Valores monetários: inteiros em centavos de BRL. Datas: timestamptz (UTC).
// Restrições adicionais (CHECKs, trigger do razão) ficam na migração
// "integrity_constraints".

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Usuários e sessões ─────────────────────────────

enum PlatformRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id              String       @id @default(cuid())
  email           String       @unique
  name            String
  phone           String?
  passwordHash    String
  // Complemento do comprador: separado do cadastro básico e do KYC do organizador.
  emailVerifiedAt DateTime?    @db.Timestamptz(3)
  cpfEncrypted    String?
  cpfHash         String?      @unique
  cpfLast2        String?      @db.VarChar(2)
  birthDate       DateTime?    @db.Date
  googleSubject   String?      @unique
  platformRole    PlatformRole @default(USER)
  status          UserStatus   @default(ACTIVE)
  suspendedReason String?
  // Contas de demonstração do seed: bloqueadas em produção.
  isDemoAccount   Boolean      @default(false)
  // Exclusão pelo titular (L9b): a linha fica, anonimizada, porque pedidos, ingressos
  // e auditoria apontam para ela. Nunca DELETE.
  anonymizedAt    DateTime?    @db.Timestamptz(3)
  createdAt       DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @db.Timestamptz(3)

  address                 UserAddress?
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  checkoutDrafts          CheckoutDraft[]
  sessions                Session[]
  memberships             OrganizationMember[]
  orders                  Order[]
  tickets                 IssuedTicket[]           @relation("TicketBuyer")
  heldTickets             IssuedTicket[]           @relation("TicketHolder")
  staffAssignments        EventStaffAssignment[]   @relation("StaffAssignee")
  checkins                TicketCheckin[]
  auditLogs               AuditLog[]

  transfersOut          TicketTransfer[]      @relation("TransferFrom")
  transfersIn           TicketTransfer[]      @relation("TransferTo")
  transfersCreated      TicketTransfer[]      @relation("TransferCreatedBy")
  transfersDecided      TicketTransfer[]      @relation("TransferDecidedBy")
  eventChanges          EventChange[]
  cancellationRequests  CancellationRequest[] @relation("CancellationRequester")
  cancellationsAssigned CancellationRequest[] @relation("CancellationAssignee")
  cancellationsDecided  CancellationRequest[] @relation("CancellationDecider")
  termsAcceptances      TermsAcceptance[]
}

// Endereço salvo somente quando o comprador informa no checkout.
model UserAddress {
  userId     String   @id
  postalCode String   @db.VarChar(8)
  street     String   @db.VarChar(200)
  number     String   @db.VarChar(30)
  complement String?  @db.VarChar(200)
  district   String   @db.VarChar(120)
  city       String   @db.VarChar(120)
  state      String   @db.VarChar(2)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmailVerificationToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime  @db.Timestamptz(3)
  consumedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
}

// Carrinho persistido: não representa estoque reservado nem pagamento confirmado.
model CheckoutDraft {
  idempotencyKey String    @unique
  id             String    @id @default(cuid())
  tokenHash      String    @unique
  userId         String?
  eventId        String
  selection      Json
  revision       Int       @default(0)
  expiresAt      DateTime  @db.Timestamptz(3)
  orderId        String?   @unique
  pricingHash    String?
  reviewHash     String?
  confirmedAt    DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)
  user           User?     @relation(fields: [userId], references: [id], onDelete: Restrict)
  event          Event     @relation(fields: [eventId], references: [id], onDelete: Restrict)
  order          Order?    @relation(fields: [orderId, userId, eventId], references: [id, userId, eventId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([orderId, userId, eventId])
  @@index([userId, updatedAt])
  @@index([expiresAt])
}

model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  expiresAt  DateTime @db.Timestamptz(3)
  lastSeenAt DateTime @default(now()) @db.Timestamptz(3)
  userAgent  String?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ───────────────────────────── Organizações ─────────────────────────────

enum OrganizationStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

enum OrganizerLegalType {
  INDIVIDUAL
  COMPANY
}

enum PaymentAccountStatus {
  NOT_CONNECTED
  PENDING
  CONNECTED
  SIMULATED
  DISABLED
}

model Organization {
  id                       String               @id @default(cuid())
  slug                     String               @unique
  name                     String
  description              String?
  legalType                OrganizerLegalType
  contactEmail             String
  contactPhone             String?
  cityId                   String?
  websiteUrl               String?
  instagramHandle          String?
  status                   OrganizationStatus   @default(DRAFT)
  // Quando verdadeiro, eventos enviados são publicados sem moderação manual.
  autoPublishEvents        Boolean              @default(false)
  paymentProvider          String?
  paymentAccountStatus     PaymentAccountStatus @default(NOT_CONNECTED)
  paymentAccountExternalId String?
  statusReason             String?
  createdAt                DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime             @updatedAt @db.Timestamptz(3)

  city               City?                    @relation(fields: [cityId], references: [id])
  members            OrganizationMember[]
  invitations        OrganizationInvitation[]
  verifications      OrganizerVerification[]
  events             Event[]
  venues             Venue[]
  orders             Order[]
  commissionRules    CommissionRule[]
  ledgerEntries      FinancialLedgerEntry[]
  settlements        OrganizerSettlement[]
  mercadoPagoAccount MercadoPagoAccount?
  auditLogs          AuditLog[]
  coupons            Coupon[]
  trackingLinks      TrackingLink[]
  eventChanges       EventChange[]
  cancellations      CancellationRequest[]
  termsAcceptances   TermsAcceptance[]

  @@index([status])
}

model MercadoPagoAccount {
  id                    String    @id @default(cuid())
  organizationId        String    @unique
  mercadoPagoUserId     String
  accessTokenEncrypted  String    @db.Text
  refreshTokenEncrypted String    @db.Text
  tokenExpiresAt        DateTime  @db.Timestamptz(3)
  connectedAt           DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)
  revokedAt             DateTime? @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([mercadoPagoUserId])
}

enum OrgRole {
  OWNER
  ADMIN
  EVENT_MANAGER
  FINANCE
  CHECKIN_STAFF
}

model OrganizationMember {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           OrgRole
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

model OrganizationInvitation {
  id             String    @id @default(cuid())
  organizationId String
  email          String
  role           OrgRole
  // Evento atribuído automaticamente ao aceitar (equipe de check-in).
  eventId        String?
  tokenHash      String    @unique
  invitedById    String
  expiresAt      DateTime  @db.Timestamptz(3)
  acceptedAt     DateTime? @db.Timestamptz(3)
  acceptedById   String?
  revokedAt      DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, email])
}

enum VerificationStatus {
  SUBMITTED
  APPROVED
  REJECTED
}

enum DocumentType {
  CPF
  CNPJ
}

// Dados mínimos de verificação. O documento é cifrado (AES-256-GCM) e só os
// últimos dígitos ficam em claro para exibição. Documentos de identidade
// (imagens) NÃO são armazenados: ficam a cargo do onboarding do provedor.
model OrganizerVerification {
  id                String             @id @default(cuid())
  organizationId    String
  legalType         OrganizerLegalType
  legalName         String
  documentType      DocumentType
  documentEncrypted String
  documentLast4     String
  status            VerificationStatus @default(SUBMITTED)
  submittedById     String
  reviewedById      String?
  reviewedAt        DateTime?          @db.Timestamptz(3)
  decisionNote      String?
  createdAt         DateTime           @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([status])
}

// ───────────────────────────── Locais ─────────────────────────────

model City {
  id         String   @id @default(cuid())
  slug       String   @unique
  name       String
  state      String   @db.Char(2)
  ibgeCode   String?  @unique
  timezone   String
  isFeatured Boolean  @default(false)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  venues        Venue[]
  events        Event[]
  organizations Organization[]

  @@unique([name, state])
  @@index([state])
}

model Venue {
  id                String   @id @default(cuid())
  organizationId    String?
  cityId            String
  name              String
  slug              String
  addressLine       String?
  district          String?
  postalCode        String?
  capacity          Int?
  accessibilityInfo String?
  // Locais fictícios do seed não têm endereço real.
  isFictional       Boolean  @default(false)
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)

  city         City          @relation(fields: [cityId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])
  events       Event[]

  @@unique([cityId, slug])
  @@index([organizationId])
}

// ───────────────────────────── Eventos ─────────────────────────────

enum EventStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  CANCELLED
  COMPLETED
  ARCHIVED
}

enum LocationType {
  VENUE
  ONLINE
}

model EventCategory {
  id        String  @id @default(cuid())
  slug      String  @unique
  name      String
  sortOrder Int     @default(0)
  events    Event[]
}

model Event {
  id                        String       @id @default(cuid())
  organizationId            String
  slug                      String       @unique
  title                     String
  summary                   String?
  description               String
  categoryId                String
  coverImageUrl             String?
  locationType              LocationType @default(VENUE)
  venueId                   String?
  onlineUrl                 String?
  cityId                    String?
  startsAt                  DateTime     @db.Timestamptz(3)
  endsAt                    DateTime     @db.Timestamptz(3)
  timezone                  String
  // 0 = livre; caso contrário idade mínima.
  ageRestriction            Int          @default(0)
  salesStartAt              DateTime     @db.Timestamptz(3)
  salesEndAt                DateTime     @db.Timestamptz(3)
  capacity                  Int
  // Cota de meia-entrada em pontos-base da capacidade (ex.: 4000 = 40%).
  // Nulo = sem cota configurada. Requer revisão jurídica.
  halfPriceQuotaBps         Int?
  // Limite de ingressos por conta neste evento (R4, Decreto 13.108/2026). Nulo = sem
  // limite; CHECK > 0. Contagem e exceções ficam no serviço (L4b).
  maxTicketsPerAccount      Int?
  status                    EventStatus  @default(DRAFT)
  isFeatured                Boolean      @default(false)
  refundPolicy              String
  // Reembolso a pedido do comprador: até N dias após a compra E até N horas antes do
  // início. Definido pelo organizador; com vendas, só pode ficar mais generoso.
  // CHECKs: dias 0–365, horas 0–720. Requer revisão jurídica (CDC art. 49).
  refundWindowDays          Int          @default(7)
  refundMinHoursBeforeEvent Int          @default(48)
  // Transferência: antecedência em horas (0–8760), total por ingresso (1–10) e
  // permissão de nova transferência consentida para um titular anterior.
  transferDeadlineHours     Int          @default(24)
  transferMaxTransfers      Int          @default(1)
  transferAllowReturn       Boolean      @default(false)
  accessibilityInfo         String?
  moderationNote            String?
  publishedAt               DateTime?    @db.Timestamptz(3)
  cancelledAt               DateTime?    @db.Timestamptz(3)
  cancellationReason        String?
  createdAt                 DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt                 DateTime     @updatedAt @db.Timestamptz(3)

  organization     Organization           @relation(fields: [organizationId], references: [id])
  category         EventCategory          @relation(fields: [categoryId], references: [id])
  venue            Venue?                 @relation(fields: [venueId], references: [id])
  city             City?                  @relation(fields: [cityId], references: [id])
  images           EventImage[]
  ticketTypes      TicketType[]
  checkoutDrafts   CheckoutDraft[]
  orders           Order[]
  tickets          IssuedTicket[]
  checkins         TicketCheckin[]
  staffAssignments EventStaffAssignment[]
  commissionRules  CommissionRule[]
  coupons          Coupon[]
  trackingLinks    TrackingLink[]
  transfers        TicketTransfer[]
  changes          EventChange[]
  cancellations    CancellationRequest[]

  // Alvo das FKs compostas de Coupon e TrackingLink (evento da mesma organização).
  @@unique([id, organizationId])
  @@index([status, startsAt])
  @@index([cityId, status, startsAt])
  @@index([organizationId, status])
  @@index([categoryId, status])
}

model EventImage {
  id         String   @id @default(cuid())
  eventId    String
  url        String
  storageKey String?
  alt        String
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model EventStaffAssignment {
  id           String   @id @default(cuid())
  eventId      String
  userId       String
  assignedById String
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation("StaffAssignee", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId])
}

// ───────────────────────────── Ingressos e estoque ─────────────────────────────

enum TicketKind {
  GENERAL
  VIP
  PROMOTIONAL
  EARLY_BIRD
  HALF_PRICE
  FREE
}

// Disponível = quantityTotal - quantityReserved - quantitySold.
// quantitySold é monotônico (inclui reembolsados/cancelados); ingressos
// reembolsados NÃO voltam ao estoque por padrão.
model TicketType {
  id                   String     @id @default(cuid())
  eventId              String
  name                 String
  description          String?
  kind                 TicketKind @default(GENERAL)
  priceCents           Int
  quantityTotal        Int
  quantityReserved     Int        @default(0)
  quantitySold         Int        @default(0)
  quantityRefunded     Int        @default(0)
  quantityCancelled    Int        @default(0)
  minPerOrder          Int        @default(1)
  maxPerOrder          Int        @default(10)
  salesStartAt         DateTime?  @db.Timestamptz(3)
  salesEndAt           DateTime?  @db.Timestamptz(3)
  requiresAttendeeInfo Boolean    @default(false)
  isHidden             Boolean    @default(false)
  sortOrder            Int        @default(0)
  createdAt            DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime   @updatedAt @db.Timestamptz(3)

  event        Event                        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  reservations TicketInventoryReservation[]
  orderItems   OrderItem[]
  tickets      IssuedTicket[]
  coupons      CouponTicketType[]

  @@index([eventId, sortOrder])
}

enum ReservationStatus {
  ACTIVE
  CONVERTED
  RELEASED
}

model TicketInventoryReservation {
  id            String            @id @default(cuid())
  orderId       String
  ticketTypeId  String
  quantity      Int
  status        ReservationStatus @default(ACTIVE)
  expiresAt     DateTime          @db.Timestamptz(3)
  releasedAt    DateTime?         @db.Timestamptz(3)
  releaseReason String?
  createdAt     DateTime          @default(now()) @db.Timestamptz(3)

  order      Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ticketType TicketType @relation(fields: [ticketTypeId], references: [id])

  @@unique([orderId, ticketTypeId])
  @@index([status, expiresAt])
}

// ───────────────────────────── Pedidos ─────────────────────────────

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PAYMENT_FAILED
  EXPIRED
  CANCELLED
  REFUND_PENDING
  REFUNDED
  DISPUTED
}

model Order {
  id                     String      @id @default(cuid())
  publicCode             String      @unique
  userId                 String
  eventId                String
  organizationId         String
  status                 OrderStatus @default(PENDING_PAYMENT)
  currency               String      @default("BRL")
  // Soma dos valores de face.
  subtotalCents          Int
  // Taxa de serviço cobrada do comprador (0 quando a comissão é do organizador).
  serviceFeeCents        Int
  totalCents             Int
  // Comissão da plataforma (independente de quem paga).
  commissionCents        Int
  feePolicyVersion       String
  commissionRuleId       String?
  buyerName              String
  buyerEmail             String
  buyerPhone             String?
  // Comprador e participantes anonimizados (exclusão da conta ou expurgo por prazo).
  piiRedactedAt          DateTime?   @db.Timestamptz(3)
  checkoutReviewRequired Boolean     @default(false)
  checkoutReviewedAt     DateTime?   @db.Timestamptz(3)
  idempotencyKey         String
  isSimulated            Boolean     @default(false)
  expiresAt              DateTime    @db.Timestamptz(3)
  paidAt                 DateTime?   @db.Timestamptz(3)
  cancelledAt            DateTime?   @db.Timestamptz(3)
  createdAt              DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime    @updatedAt @db.Timestamptz(3)
  // Instantâneos imutáveis da compra (ADR 0002). couponCode é a cópia do código usado.
  couponId               String?
  couponCode             String?     @db.VarChar(32)
  // Σ discountPerUnitCents × quantity dos itens.
  discountCents          Int         @default(0)
  trackingLinkId         String?
  utmSource              String?     @db.VarChar(200)
  utmMedium              String?     @db.VarChar(200)
  utmCampaign            String?     @db.VarChar(200)
  utmContent             String?     @db.VarChar(200)
  utmTerm                String?     @db.VarChar(200)

  user             User                         @relation(fields: [userId], references: [id])
  event            Event                        @relation(fields: [eventId], references: [id])
  organization     Organization                 @relation(fields: [organizationId], references: [id])
  commissionRule   CommissionRule?              @relation(fields: [commissionRuleId], references: [id])
  // Cupom da mesma organização do pedido; Restrict porque o cupom usado é histórico.
  coupon           Coupon?                      @relation(fields: [couponId, organizationId], references: [id, organizationId], onDelete: Restrict)
  trackingLink     TrackingLink?                @relation(fields: [trackingLinkId], references: [id], onDelete: Restrict)
  items            OrderItem[]
  reservations     TicketInventoryReservation[]
  payments         Payment[]
  tickets          IssuedTicket[]
  refunds          Refund[]
  ledgerEntries    FinancialLedgerEntry[]
  cancellations    CancellationRequest[]
  termsAcceptances TermsAcceptance[]

  checkoutDraft CheckoutDraft?

  @@unique([userId, idempotencyKey])
  @@unique([id, userId, eventId])
  @@unique([id, eventId, organizationId])
  @@index([eventId, status])
  @@index([organizationId, status, createdAt])
  @@index([status, expiresAt])
  @@index([userId, createdAt])
  // Limite por conta por evento (R4): pedidos e reservas da conta no evento.
  @@index([userId, eventId, status])
  // Limite de usos por comprador; também cobre consultas só por couponId.
  @@index([couponId, userId])
  @@index([trackingLinkId])
}

model OrderItem {
  id                     String     @id @default(cuid())
  orderId                String
  ticketTypeId           String
  // Snapshots do momento da compra.
  ticketTypeName         String
  kind                   TicketKind
  // Preço efetivamente cobrado = listUnitPriceCents - discountPerUnitCents (CHECK OrderItem_discount).
  unitPriceCents         Int
  // Preço de tabela no momento da compra.
  listUnitPriceCents     Int
  discountPerUnitCents   Int        @default(0)
  commissionPerUnitCents Int
  serviceFeePerUnitCents Int
  quantity               Int
  // [{ name, email?, document? }] quando o tipo exige dados do participante.
  attendees              Json?

  order      Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ticketType TicketType     @relation(fields: [ticketTypeId], references: [id])
  tickets    IssuedTicket[]

  @@unique([orderId, ticketTypeId])
}

// ───────────────────────────── Cupons e links rastreados ─────────────────────────────
// ADR 0002. Regras de uso e contadores ficam no serviço; CHECKs na migração
// 20261027120000_coupons_tracking_links. Cupom/link usado não é apagado, só
// desativado (disabledAt/archivedAt).

enum DiscountType {
  PERCENT
  FIXED_PER_TICKET
}

model Coupon {
  id             String       @id @default(cuid())
  organizationId String
  // Nulo = todos os eventos da organização.
  eventId        String?
  // Maiúsculas, ^[A-Z0-9_-]{3,32}$ (CHECK).
  code           String       @db.VarChar(32)
  description    String?      @db.VarChar(200)
  discountType   DiscountType
  percentBps     Int?
  amountCents    Int?
  validFrom      DateTime?    @db.Timestamptz(3)
  validUntil     DateTime?    @db.Timestamptz(3)
  // Nulo = ilimitado. O limite não é CHECK: pagamento tardio pode ultrapassá-lo (auditado).
  maxUses        Int?
  maxUsesPerUser Int?         @default(1)
  timesReserved  Int          @default(0)
  timesRedeemed  Int          @default(0)
  disabledAt     DateTime?    @db.Timestamptz(3)
  createdById    String
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  event        Event?             @relation(fields: [eventId, organizationId], references: [id, organizationId], onDelete: Restrict)
  ticketTypes  CouponTicketType[]
  orders       Order[]
  links        TrackingLink[]

  @@unique([organizationId, code])
  // Alvo de Order(couponId, organizationId).
  @@unique([id, organizationId])
  @@index([eventId])
}

// Sem linhas = todos os tipos pagos do evento. Tipos do mesmo evento do cupom: checado no serviço.
model CouponTicketType {
  couponId     String
  ticketTypeId String

  coupon     Coupon     @relation(fields: [couponId], references: [id], onDelete: Cascade)
  ticketType TicketType @relation(fields: [ticketTypeId], references: [id], onDelete: Cascade)

  @@id([couponId, ticketTypeId])
  @@index([ticketTypeId])
}

model TrackingLink {
  id             String    @id @default(cuid())
  organizationId String
  eventId        String
  // Curto, público, aleatório: ^[A-Za-z0-9]{6,16}$ (CHECK).
  code           String    @unique @db.VarChar(16)
  name           String    @db.VarChar(120)
  utmSource      String?   @db.VarChar(200)
  utmMedium      String?   @db.VarChar(200)
  utmCampaign    String?   @db.VarChar(200)
  utmContent     String?   @db.VarChar(200)
  utmTerm        String?   @db.VarChar(200)
  // Pré-aplica um cupom; mesma organização checada no serviço (FK simples por causa do SetNull).
  couponId       String?
  clicks         Int       @default(0)
  archivedAt     DateTime? @db.Timestamptz(3)
  createdById    String
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  event        Event        @relation(fields: [eventId, organizationId], references: [id, organizationId], onDelete: Restrict)
  coupon       Coupon?      @relation(fields: [couponId], references: [id], onDelete: SetNull)
  orders       Order[]

  @@index([eventId])
  @@index([couponId])
}

// ───────────────────────────── Pagamentos ─────────────────────────────

enum PaymentMethod {
  PIX
  CREDIT_CARD
  FREE
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  CANCELLED
  REFUNDED
  DISPUTED
  CHARGED_BACK
}

model Payment {
  id                 String        @id @default(cuid())
  orderId            String
  provider           String
  providerPaymentId  String?
  providerPreferenceId String?
  method             PaymentMethod
  status             PaymentStatus @default(PENDING)
  amountCents        Int
  processingFeeCents Int?
  pixCopyPaste       String?
  pixQrCodeBase64    String?
  checkoutUrl        String?
  providerExpiresAt  DateTime?     @db.Timestamptz(3)
  providerRawStatus  String?
  failureReason      String?
  isSimulated        Boolean       @default(false)
  idempotencyKey     String        @unique
  paidAt             DateTime?     @db.Timestamptz(3)
  createdAt          DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime      @updatedAt @db.Timestamptz(3)

  order         Order                  @relation(fields: [orderId], references: [id])
  refunds       Refund[]
  ledgerEntries FinancialLedgerEntry[]

  @@unique([provider, providerPaymentId])
  @@index([orderId])
  @@index([status, createdAt])
}

model PaymentWebhookEvent {
  id                String    @id @default(cuid())
  provider          String
  externalEventId   String
  eventType         String
  providerPaymentId String?
  payload           Json
  receivedAt        DateTime  @default(now()) @db.Timestamptz(3)
  processedAt       DateTime? @db.Timestamptz(3)
  processingResult  String?
  error             String?
  attempts          Int       @default(1)

  @@unique([provider, externalEventId])
  @@index([providerPaymentId])
}

// Estado do provedor FICTÍCIO usado em desenvolvimento. Nunca representa
// dinheiro real.
enum SimulatedPaymentState {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  REFUNDED
  CHARGED_BACK
}

model SimulatedProviderPayment {
  id          String                @id @default(cuid())
  externalRef String
  method      PaymentMethod
  amountCents Int
  state       SimulatedPaymentState @default(PENDING)
  expiresAt   DateTime              @db.Timestamptz(3)
  refundedAt  DateTime?             @db.Timestamptz(3)
  createdAt   DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime              @updatedAt @db.Timestamptz(3)
}

// ───────────────────────────── Ingressos emitidos e check-in ─────────────────────────────

enum TicketStatus {
  VALID
  CHECKED_IN
  REVOKED
}

enum TicketRevocationReason {
  REFUNDED
  EVENT_CANCELLED
  CHARGEBACK
  ADMIN
}

model IssuedTicket {
  id               String                  @id @default(cuid())
  code             String                  @unique
  orderId          String
  orderItemId      String
  eventId          String
  ticketTypeId     String
  // Comprador (quem pagou). Não muda na transferência; o reembolso segue o pagamento (D7).
  userId           String
  // Titular atual (R6). Sem valor no INSERT, o gatilho IssuedTicket_default_holder
  // preenche com userId; depois muda só pelo aceite de TicketTransfer.
  holderUserId     String                  @default(dbgenerated())
  sequence         Int
  holderName       String?
  holderEmail      String?
  // Titular anonimizado (exclusão da conta ou expurgo por prazo).
  piiRedactedAt    DateTime?               @db.Timestamptz(3)
  validationToken  String                  @unique
  status           TicketStatus            @default(VALID)
  revokedAt        DateTime?               @db.Timestamptz(3)
  revocationReason TicketRevocationReason?
  checkedInAt      DateTime?               @db.Timestamptz(3)
  issuedAt         DateTime                @default(now()) @db.Timestamptz(3)

  order      Order            @relation(fields: [orderId], references: [id])
  orderItem  OrderItem        @relation(fields: [orderItemId], references: [id])
  event      Event            @relation(fields: [eventId], references: [id])
  ticketType TicketType       @relation(fields: [ticketTypeId], references: [id])
  user       User             @relation("TicketBuyer", fields: [userId], references: [id])
  holder     User             @relation("TicketHolder", fields: [holderUserId], references: [id], onDelete: Restrict)
  checkins   TicketCheckin[]
  transfers  TicketTransfer[]

  // Garante emissão única por unidade do item, mesmo com webhooks concorrentes.
  @@unique([orderItemId, sequence])
  @@index([eventId, status])
  @@index([userId, issuedAt])
  @@index([orderId])
  // "Meus ingressos" pelo titular atual.
  @@index([holderUserId, issuedAt])
  // Limite por conta por evento (R4): ingressos em mãos e ingressos comprados.
  @@index([eventId, holderUserId])
  @@index([eventId, userId])
}

enum CheckinResult {
  ADMITTED
  DUPLICATE
  WRONG_EVENT
  REVOKED
  INVALID
  EVENT_NOT_ACTIVE
}

model TicketCheckin {
  id          String        @id @default(cuid())
  ticketId    String?
  eventId     String
  scannedById String
  result      CheckinResult
  scannedAt   DateTime      @default(now()) @db.Timestamptz(3)

  ticket    IssuedTicket? @relation(fields: [ticketId], references: [id])
  event     Event         @relation(fields: [eventId], references: [id])
  scannedBy User          @relation(fields: [scannedById], references: [id])

  @@index([eventId, scannedAt])
  @@index([ticketId])
}

// ───────────────────────────── Reembolsos ─────────────────────────────

enum RefundStatus {
  REQUESTED
  PROCESSING
  SUCCEEDED
  REJECTED
  FAILED
}

enum RefundReason {
  CUSTOMER_REQUEST
  EVENT_CANCELLED
  LATE_PAYMENT_NO_INVENTORY
  ADMIN
  // Janela de reembolso integral por alteração relevante (R8, L8a).
  EVENT_CHANGED
}

model Refund {
  id               String       @id @default(cuid())
  orderId          String
  paymentId        String?
  amountCents      Int
  status           RefundStatus @default(REQUESTED)
  reason           RefundReason
  requestedById    String?
  providerRefundId String?
  note             String?
  idempotencyKey   String       @unique
  processedAt      DateTime?    @db.Timestamptz(3)
  createdAt        DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @db.Timestamptz(3)

  // Alteração de evento que abriu a janela (reason = EVENT_CHANGED).
  eventChangeId         String?
  // Pedido de cancelamento atendido. Sem unicidade: um reembolso que falha é seguido de outro.
  cancellationRequestId String?

  order               Order                  @relation(fields: [orderId], references: [id])
  payment             Payment?               @relation(fields: [paymentId], references: [id])
  eventChange         EventChange?           @relation(fields: [eventChangeId], references: [id], onDelete: Restrict)
  cancellationRequest CancellationRequest?   @relation(fields: [cancellationRequestId], references: [id], onDelete: Restrict)
  ledgerEntries       FinancialLedgerEntry[]

  @@index([status, createdAt])
  @@index([orderId])
  @@index([eventChangeId])
  @@index([cancellationRequestId])
}

// ───────────────────────────── Conformidade (Decreto 13.108/2026) ─────────────────────────────
// ADR 0003. CHECKs, índices parciais e gatilhos de imutabilidade ficam na migração
// 20261027180000_compliance_schema. FKs Restrict: o histórico não some junto com
// ingresso, usuário ou evento. Prazos e regras legais (D1–D8) ficam no serviço.

enum TicketTransferStatus {
  PENDING
  ACCEPTED
  CANCELLED
  EXPIRED
}

enum TicketTransferInitiator {
  // O titular pede; o destinatário aceita com o token.
  HOLDER
  // Reversão/correção pelo admin (fraude): nasce decidida, sem token, com motivo.
  ADMIN
}

// Transferência de titularidade (R6). Histórico ≥ 2 anos: só INSERT e a transição
// PENDING → decidida (gatilho TicketTransfer_append_only); depois, imutável.
model TicketTransfer {
  id                 String                  @id @default(cuid())
  ticketId           String
  eventId            String
  initiatedBy        TicketTransferInitiator @default(HOLDER)
  // Titular no momento do pedido; nome e e-mail copiados (User/IssuedTicket mudam).
  fromUserId         String
  fromHolderName     String                  @db.VarChar(200)
  fromHolderEmail    String                  @db.VarChar(254)
  // Nulo até o aceite, se o destinatário ainda não tem conta.
  toUserId           String?
  // Minúsculas (CHECK).
  toEmail            String                  @db.VarChar(254)
  toHolderName       String?                 @db.VarChar(200)
  status             TicketTransferStatus    @default(PENDING)
  // SHA-256 hex do token de aceite (nunca o token). Obrigatório só em HOLDER.
  tokenHash          String?                 @unique @db.Char(64)
  // SHA-256 hex do validationToken (QR) invalidado no aceite.
  previousTokenHash  String?                 @db.Char(64)
  // Reversão pelo admin aponta para a transferência revertida.
  reversesTransferId String?                 @unique
  // Motivo do pedido; obrigatório em ADMIN.
  reason             String?                 @db.VarChar(2000)
  // Quem criou: o titular (HOLDER) ou o admin.
  createdById        String
  createdAt          DateTime                @default(now()) @db.Timestamptz(3)
  // Obrigatório em HOLDER; o prazo vem do serviço (D7).
  expiresAt          DateTime?               @db.Timestamptz(3)
  decidedAt          DateTime?               @db.Timestamptz(3)
  // Destinatário (aceite), remetente ou admin (cancelamento); nulo = expiração automática.
  decidedById        String?
  decisionReason     String?                 @db.VarChar(500)
  requestIp          String?                 @db.VarChar(64)
  requestUserAgent   String?                 @db.VarChar(512)
  decisionIp         String?                 @db.VarChar(64)
  decisionUserAgent  String?                 @db.VarChar(512)

  ticket           IssuedTicket    @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  event            Event           @relation(fields: [eventId], references: [id], onDelete: Restrict)
  fromUser         User            @relation("TransferFrom", fields: [fromUserId], references: [id], onDelete: Restrict)
  toUser           User?           @relation("TransferTo", fields: [toUserId], references: [id], onDelete: Restrict)
  createdBy        User            @relation("TransferCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  decidedBy        User?           @relation("TransferDecidedBy", fields: [decidedById], references: [id], onDelete: Restrict)
  reversesTransfer TicketTransfer? @relation("TransferReversal", fields: [reversesTransferId], references: [id], onDelete: Restrict)
  reversedBy       TicketTransfer? @relation("TransferReversal")

  @@index([ticketId, createdAt])
  @@index([eventId, createdAt])
  @@index([fromUserId, createdAt])
  @@index([toUserId, createdAt])
  @@index([toEmail, status])
  @@index([status, expiresAt])
  // Lista do admin por status, mais recentes primeiro (Fase 4).
  @@index([status, createdAt])
}

// Alteração relevante ou adiamento (R8). Somente inserção. O que é "relevante" e o
// tamanho da janela são D2: `relevant` e `refundUntil` ficam nulos até o serviço decidir.
// O aviso aos compradores vai para AuditLog (a linha não muda depois de gravada).
model EventChange {
  id              String    @id @default(cuid())
  eventId         String
  organizationId  String
  // Nulo = sistema.
  actorUserId     String?
  // Chaves alteradas; [] numa prorrogação de janela.
  changedFields   String[]
  // { campo: valor } com datas em ISO UTC; sem dados pessoais.
  before          Json
  after           Json
  reason          String    @db.VarChar(2000)
  relevant        Boolean?
  // Janela de reembolso integral desta alteração (vale para pedidos pagos antes de createdAt).
  refundUntil     DateTime? @db.Timestamptz(3)
  // Prorrogação: aponta para a alteração original.
  extendsChangeId String?
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)

  event        Event         @relation(fields: [eventId, organizationId], references: [id, organizationId], onDelete: Restrict)
  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actor        User?         @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  extends      EventChange?  @relation("EventChangeExtension", fields: [extendsChangeId], references: [id], onDelete: Restrict)
  extensions   EventChange[] @relation("EventChangeExtension")
  refunds      Refund[]

  @@index([eventId, createdAt])
  @@index([eventId, refundUntil])
  @@index([organizationId, createdAt])
  @@index([refundUntil])
  @@index([extendsChangeId])
}

enum CancellationRequestStatus {
  OPEN
  APPROVED
  REJECTED
  WITHDRAWN
}

// Pedido de cancelamento/arrependimento com protocolo (R5). Tem ciclo de vida
// (OPEN → decidido), mas os campos do pedido não mudam e a linha decidida fica
// congelada (gatilho CancellationRequest_guard). Mudanças vão para AuditLog.
model CancellationRequest {
  id                    String                    @id @default(cuid())
  // Gerado pelo serviço: CAN-AAAAMMDD-XXXXXX (base32 sem I, L, O, U). CHECK de formato.
  protocol              String                    @unique @db.VarChar(32)
  orderId               String
  eventId               String
  organizationId        String
  requestedById         String
  reason                String                    @db.VarChar(2000)
  status                CancellationRequestStatus @default(OPEN)
  // Prazo de resposta (D3). Pode ser definido uma vez; depois não muda.
  respondBy             DateTime?                 @db.Timestamptz(3)
  // Resultado de refundEligibility no momento do pedido (SAC/auditoria).
  autoEligibleAtRequest Boolean?
  assignedToId          String?
  assignedAt            DateTime?                 @db.Timestamptz(3)
  // Obrigatória em REJECTED.
  decisionNote          String?                   @db.VarChar(2000)
  // Em WITHDRAWN, o próprio solicitante.
  decidedById           String?
  decidedAt             DateTime?                 @db.Timestamptz(3)
  createdAt             DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime                  @updatedAt @db.Timestamptz(3)

  order        Order        @relation(fields: [orderId, eventId, organizationId], references: [id, eventId, organizationId], onDelete: Restrict)
  event        Event        @relation(fields: [eventId, organizationId], references: [id, organizationId], onDelete: Restrict)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  requestedBy  User         @relation("CancellationRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  assignedTo   User?        @relation("CancellationAssignee", fields: [assignedToId], references: [id], onDelete: Restrict)
  decidedBy    User?        @relation("CancellationDecider", fields: [decidedById], references: [id], onDelete: Restrict)
  refunds      Refund[]

  // Fila do admin (respondBy fica nulo até D3).
  @@index([status, createdAt])
  @@index([status, respondBy])
  @@index([eventId, status])
  @@index([organizationId, status, createdAt])
  @@index([orderId])
  @@index([requestedById, createdAt])
  // Decididos no admin, mais recentes primeiro (Fase 4).
  @@index([status, decidedAt])
}

enum TermsKind {
  BUYER
  ORGANIZER
  PRIVACY
}

enum TermsAcceptanceContext {
  SIGNUP
  CHECKOUT
  ORGANIZER_SIGNUP
  // Aceite de versão nova pedido depois do cadastro.
  REACCEPT
}

// Versão publicada de termos/política (R10). Somente inserção: texto novo = versão nova.
model TermsVersion {
  id           String    @id @default(cuid())
  kind         TermsKind
  version      String    @db.VarChar(32)
  // SHA-256 hex do texto exibido.
  textHash     String    @db.Char(64)
  // Onde o texto é exibido (ex.: /termos).
  documentPath String?   @db.VarChar(200)
  // Rascunho técnico até D8; a versão final é uma linha nova.
  isDraft      Boolean   @default(true)
  publishedAt  DateTime  @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)

  acceptances TermsAcceptance[]

  @@unique([kind, version])
  @@index([kind, publishedAt])
}

// Um registro por evento de aceite (somente inserção). No checkout aponta o pedido;
// no contrato de organizador, a organização.
model TermsAcceptance {
  id             String                 @id @default(cuid())
  userId         String
  termsVersionId String
  context        TermsAcceptanceContext
  organizationId String?
  orderId        String?
  acceptedAt     DateTime               @default(now()) @db.Timestamptz(3)
  ip             String?                @db.VarChar(64)
  userAgent      String?                @db.VarChar(512)

  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  termsVersion TermsVersion  @relation(fields: [termsVersionId], references: [id], onDelete: Restrict)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  order        Order?        @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([userId, termsVersionId])
  @@index([termsVersionId])
  @@index([organizationId])
  @@index([orderId])
}

// ───────────────────────────── Comissão e razão financeiro ─────────────────────────────

enum CommissionScope {
  PLATFORM
  ORGANIZATION
  EVENT
}

// Quem paga a comissão da plataforma.
enum FeeBearer {
  ORGANIZER
  BUYER
}

// Quem absorve o custo do processador de pagamento.
enum ProcessingFeeBearer {
  ORGANIZER
  PLATFORM
}

// Regras são imutáveis: alterar = encerrar (activeTo) e criar nova versão.
model CommissionRule {
  id                       String              @id @default(cuid())
  scope                    CommissionScope
  organizationId           String?
  eventId                  String?
  percentBps               Int
  fixedCentsPerTicket      Int                 @default(0)
  bearer                   FeeBearer           @default(ORGANIZER)
  processingFeeBearer      ProcessingFeeBearer @default(ORGANIZER)
  refundCommissionOnRefund Boolean             @default(true)
  policyVersion            String              @unique
  activeFrom               DateTime            @default(now()) @db.Timestamptz(3)
  activeTo                 DateTime?           @db.Timestamptz(3)
  createdById              String?
  createdAt                DateTime            @default(now()) @db.Timestamptz(3)

  organization Organization? @relation(fields: [organizationId], references: [id])
  event        Event?        @relation(fields: [eventId], references: [id])
  orders       Order[]

  @@index([scope, organizationId, eventId, activeFrom])
}

enum LedgerAccount {
  CUSTOMER_FUNDS
  ORGANIZER_PAYABLE
  PLATFORM_COMMISSION
  PLATFORM_SERVICE_FEE
  PROCESSING_FEES
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

enum LedgerEntryType {
  SALE
  PROCESSING_FEE
  REFUND
  CHARGEBACK
  SETTLEMENT
  ADJUSTMENT
}

// Somente inserção (trigger bloqueia UPDATE/DELETE). Cada transação contábil
// (mesmo idempotencyKey) soma débitos = créditos.
model FinancialLedgerEntry {
  id               String          @id @default(cuid())
  idempotencyKey   String
  type             LedgerEntryType
  account          LedgerAccount
  direction        LedgerDirection
  amountCents      Int
  organizationId   String
  orderId          String?
  paymentId        String?
  refundId         String?
  settlementId     String?
  feePolicyVersion String?
  description      String
  isSimulated      Boolean         @default(false)
  createdAt        DateTime        @default(now()) @db.Timestamptz(3)

  organization Organization         @relation(fields: [organizationId], references: [id])
  order        Order?               @relation(fields: [orderId], references: [id])
  payment      Payment?             @relation(fields: [paymentId], references: [id])
  refund       Refund?              @relation(fields: [refundId], references: [id])
  settlement   OrganizerSettlement? @relation(fields: [settlementId], references: [id])

  @@unique([idempotencyKey, account, direction])
  @@index([organizationId, createdAt])
  @@index([orderId])
}

enum SettlementStatus {
  NOT_CONFIGURED
  PENDING
  IN_TRANSIT
  PAID
  FAILED
}

model OrganizerSettlement {
  id                 String           @id @default(cuid())
  organizationId     String
  provider           String
  periodStart        DateTime         @db.Timestamptz(3)
  periodEnd          DateTime         @db.Timestamptz(3)
  grossCents         Int
  commissionCents    Int
  processingFeeCents Int
  refundCents        Int
  netCents           Int
  status             SettlementStatus @default(NOT_CONFIGURED)
  providerReference  String?
  isSimulated        Boolean          @default(false)
  createdAt          DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime         @updatedAt @db.Timestamptz(3)

  organization  Organization           @relation(fields: [organizationId], references: [id])
  ledgerEntries FinancialLedgerEntry[]

  @@index([organizationId, periodStart])
}

// ───────────────────────────── Auditoria ─────────────────────────────

model AuditLog {
  id             String   @id @default(cuid())
  actorUserId    String?
  organizationId String?
  action         String
  entityType     String
  entityId       String
  metadata       Json?
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  actor        User?         @relation(fields: [actorUserId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])
  // Filtro por prefixo de ação: AuditLog_action_prefix_idx (text_pattern_ops, parcial),
  // escrito à mão em 20261028120000_query_plan_indexes.

  @@index([entityType, entityId])
  @@index([organizationId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([createdAt])
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime  @db.Timestamptz(3)
  consumedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
}

enum EmailDeliveryStatus {
  QUEUED
  PROCESSING
  SENT
  FAILED
  CANCELLED
  UNKNOWN
}

model EmailOutbox {
  id                String              @id @default(cuid())
  dedupeKey         String              @unique
  template          String
  recipient         String
  payloadEncrypted  String?
  messageEncrypted  String?
  status            EmailDeliveryStatus @default(QUEUED)
  provider          String?
  providerMessageId String?
  attemptCount      Int                 @default(0)
  firstAttemptAt    DateTime?           @db.Timestamptz(3)
  nextAttemptAt     DateTime            @default(now()) @db.Timestamptz(3)
  lockedUntil       DateTime?           @db.Timestamptz(3)
  leaseToken        String?
  expiresAt         DateTime?           @db.Timestamptz(3)
  sentAt            DateTime?           @db.Timestamptz(3)
  failedAt          DateTime?           @db.Timestamptz(3)
  errorCode         String?
  createdAt         DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @db.Timestamptz(3)

  @@index([status, nextAttemptAt])
  @@index([lockedUntil])
}

model EmailRateLimit {
  key             String   @id
  count           Int      @default(0)
  windowStartedAt DateTime @db.Timestamptz(3)
}

/// Limite de tentativas compartilhado entre instâncias (janela fixa). `key` é o
/// HMAC da chave lógica (ex.: "login:<ip>"), para não guardar IP/id em claro.
model RateLimitBucket {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime @db.Timestamptz(3)

  @@index([resetAt])
}

model MercadoPagoOAuthState {
  id             String    @id @default(cuid())
  organizationId String
  actorUserId    String
  stateHash      String    @unique
  expiresAt      DateTime  @db.Timestamptz(3)
  consumedAt     DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)

  @@index([organizationId])
  @@index([expiresAt])
}
